{
  "manifest_version": 3,
  "name": "Mana Pocket Card Collector",
  "version": "1.1.0",
  "description": "Collect public set, card, parallel and photo references directly into The Mana Pocket cloud.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "alarms"],
  "host_permissions": ["https://www.pricecharting.com/*", "https://pricecharting.com/*", "https://www.sportscardspro.com/*", "https://sportscardspro.com/*", "https://squeebmike.github.io/ArSca/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open card collector"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
