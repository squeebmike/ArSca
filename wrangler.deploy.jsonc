{
  "name": "still-resonance-4f87",
  "main": "cloudflare-worker-full.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "REFERENCE_IMAGE_REFRESH_ENABLED": "1",
    "EBAY_PARTNER_CAMPAIGN_ID": "5339046175",
    "STRIPE_PLATFORM_MODE": "live",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51OhyA8LHo6HlAYnMuSJGtOtXDbU5I8NIvHqgSpoKfH8PoZ2pIHCFVyO1fkqlpcpTAQ5tgEMGbWYlA81hiwQ2HhB400tlnsrfsw",
    "CARD_LENS_ACCESS_MODE": "development-open",
    "CARD_LENS_S_RANK_REDEMPTION_ENABLED": "true",
    "CARD_LENS_SESSION_EPOCH": "1",
    "CARD_LENS_ANDROID_PACKAGE": "com.carddeallens",
    "CARD_LENS_PLAY_PRODUCTS": "card_deal_lens_pro,card_deal_lens_power"
  },
  // Logs 1 in 10 requests. Cloudflare starts charging for log volume on
  // 2026-12-01 (50 GB/month included on Workers Paid, then $0.25/GB), and
  // logging every crawler hit on the website could pass that. Anything that
  // happens repeatedly still shows up; one-off errors may not.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {"bindings":[{"name":"PUBLIC_EBAY_CACHE","class_name":"PublicEbayCache"},{"name":"CARD_REFERENCE_ARCHIVE","class_name":"CardReferenceArchive"}]},
  "migrations": [{"tag":"public-ebay-cache-v1","new_sqlite_classes":["PublicEbayCache"]},{"tag":"card-reference-archive-v1","new_sqlite_classes":["CardReferenceArchive"]}],
  "kv_namespaces": [
    {
      "binding": "LBA_KV",
      "id": "3cfb05e353364f1ab89df23f058374a9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MTG_CATALOG_R2",
      "bucket_name": "arsca-offline-catalogs"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "17 * * * *",
      // Whatnot: checked items pushed, recent orders recorded (WHATNOT_SYNC_CRON).
      "*/10 * * * *"
    ]
  },
  "workers_dev": true,
  // Store report: the bare "themanapocket.com" apex is Webflow-managed --
  // its DNS record can't stay proxied through Cloudflare (Webflow's own
  // automated domain management reverts any attempt to proxy it), so every
  // route below only ever actually reaches this Worker via
  // "www.themanapocket.com", which is proxied and stable. The apex
  // redirects to www via a Cloudflare Redirect Rule (not code in this
  // repo) rather than DNS, so it never fights Webflow's management again.
  "routes": [
    { "pattern": "www.themanapocket.com/pocket-guides*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/pocket-guides/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/secret-lair", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/secret-lair/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-secret-lair.xml", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sports/sets*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/basketball", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/basketball/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-basketball.xml*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/hockey", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/hockey/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-hockey.xml*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-sports-sets.xml*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/football", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/football/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-football.xml", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sports/checklists*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/baseball", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/baseball/*", "zone_name": "themanapocket.com" },
    // Cloudflare matches the query string too; the split sitemap uses ?part=N.
    { "pattern": "www.themanapocket.com/sitemap-baseball.xml*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/links", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/links/", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/pokemon", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/pokemon/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/sitemap-pokemon.xml", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/dougvana-print", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/index.html", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/comics/*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/comic-new-releases-the-mana-pocket*", "zone_name": "themanapocket.com" },
    { "pattern": "www.themanapocket.com/robots.txt", "zone_name": "themanapocket.com" },
    {
      "pattern": "www.themanapocket.com/mtg*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/preorder*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-preorders.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/item*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-items.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/book*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-books.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/bcw*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/supplies*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/shop*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/category*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/faq",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/news",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/articles*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-pages.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/review",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/reviews",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/public/storefront/review",
      "zone_name": "themanapocket.com"
    }
  ]
}
