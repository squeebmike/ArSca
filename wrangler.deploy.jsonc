{
  "name": "still-resonance-4f87",
  "main": "cloudflare-worker-full.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "STRIPE_PLATFORM_MODE": "live",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51OhyA8LHo6HlAYnMuSJGtOtXDbU5I8NIvHqgSpoKfH8PoZ2pIHCFVyO1fkqlpcpTAQ5tgEMGbWYlA81hiwQ2HhB400tlnsrfsw",
    "CARD_LENS_ACCESS_MODE": "development-open",
    "CARD_LENS_S_RANK_REDEMPTION_ENABLED": "true",
    "CARD_LENS_SESSION_EPOCH": "1",
    "CARD_LENS_ANDROID_PACKAGE": "com.carddeallens",
    "CARD_LENS_PLAY_PRODUCTS": "card_deal_lens_pro,card_deal_lens_power"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "LBA_KV",
      "id": "3cfb05e353364f1ab89df23f058374a9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MTG_CATALOG_R2",
      "bucket_name": "arsca-offline-catalogs"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "workers_dev": true,
  // Store report: the bare "themanapocket.com" apex is Webflow-managed --
  // its DNS record can't stay proxied through Cloudflare (Webflow's own
  // automated domain management reverts any attempt to proxy it), so every
  // route below only ever actually reaches this Worker via
  // "www.themanapocket.com", which is proxied and stable. The apex
  // redirects to www via a Cloudflare Redirect Rule (not code in this
  // repo) rather than DNS, so it never fights Webflow's management again.
  "routes": [
    {
      "pattern": "www.themanapocket.com/mtg*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/preorder*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-preorders.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/item*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-items.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/book*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-books.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/bcw*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/supplies*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/shop*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/category*",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/faq",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/news",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/sitemap-pages.xml",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/review",
      "zone_name": "themanapocket.com"
    },
    {
      "pattern": "www.themanapocket.com/public/storefront/review",
      "zone_name": "themanapocket.com"
    }
  ]
}
